@page
@model AdminDashboard.Pages.IndexModel
@{
    ViewData["Title"] = "Consultation Requests";
    Layout = "_Layout";

    static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        return parts.Length == 1 ? parts[0][..1].ToUpper() : $"{parts[0][0]}{parts[^1][0]}".ToUpper();





    }
}

<div id="dashboard">
    <header class="admin-header">
        <a class="logo" href="@Url.Page("/Index")">
            <span class="logo-mark">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.5L12 4l9 7.5"/><path d="M5.5 10v9a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-9"/><path d="M9.5 20v-6a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v6"/></svg>
            </span>
            Dwello<span>Admin</span>
        </a>
        <div class="admin-actions">
            <a class="icon-btn" title="Refresh" href="@Url.Page("/Index", new { status = Model.Status, q = Model.Q })">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>
            </a>
            <form method="post" asp-page-handler="Logout">
                <button type="submit" class="icon-btn" title="Log Out">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
                </button>
            </form>
        </div>
    </header>

    <section class="stats-row">
        <div class="stat-card">
            <span class="stat-icon stat-icon-total">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
            </span>
            <div><span class="stat-num">@Model.Total</span><label>Total</label></div>
        </div>
        <div class="stat-card stat-new">
            <span class="stat-icon stat-icon-new">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.4 7.2H22l-6 4.6 2.3 7.2-6.3-4.5-6.3 4.5 2.3-7.2-6-4.6h7.6z"/></svg>
            </span>
            <div><span class="stat-num">@Model.NewCount</span><label>New</label></div>
        </div>
        <div class="stat-card stat-contacted">
            <span class="stat-icon stat-icon-contacted">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 2 .6 2.9a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.9.5 2.9.6a2 2 0 0 1 1.7 2z"/></svg>
            </span>
            <div><span class="stat-num">@Model.ContactedCount</span><label>Contacted</label></div>
        </div>
        <div class="stat-card stat-closed">
            <span class="stat-icon stat-icon-closed">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <div><span class="stat-num">@Model.ClosedCount</span><label>Closed</label></div>
        </div>
    </section>

    <div class="toolbar">
        <div class="filter-row">
            <a class="filter-chip @(Model.Status == "all" ? "active" : "")" href="@Url.Page("/Index", new { status = "all", q = Model.Q })">All</a>
            <a class="filter-chip @(Model.Status == "new" ? "active" : "")" href="@Url.Page("/Index", new { status = "new", q = Model.Q })">New</a>
            <a class="filter-chip @(Model.Status == "contacted" ? "active" : "")" href="@Url.Page("/Index", new { status = "contacted", q = Model.Q })">Contacted</a>
            <a class="filter-chip @(Model.Status == "closed" ? "active" : "")" href="@Url.Page("/Index", new { status = "closed", q = Model.Q })">Closed</a>
        </div>

        <form method="get" class="search-form">
            <input type="hidden" name="status" value="@Model.Status" />
            <svg class="search-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.3-4.3"/></svg>
            <input type="search" name="q" value="@Model.Q" placeholder="Search name, phone, email…" />
        </form>
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Type / City</th>
                    <th>Source</th>
                    <th>Message</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Leads.Any())
                {
                    <tr class="no-hover"><td colspan="9" class="empty-row"><span class="empty-icon">📭</span><br />No consultation requests match here.</td></tr>
                }
                else
                {
                    @foreach (var lead in Model.Leads)
                    {
                        <tr>
                            <td data-label="Date">@lead.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</td>
                            <td data-label="Name">
                                <div class="name-cell">
                                    <span class="avatar">@Initials(lead.Name)</span>
                                    <span>@(string.IsNullOrEmpty(lead.Name) ? "—" : lead.Name)</span>
                                </div>
                            </td>
                            <td data-label="Phone">
                                @if (!string.IsNullOrEmpty(lead.Phone)) { <a class="cell-link" href="tel:@lead.Phone">@lead.Phone</a> } else { <text>—</text> }
                            </td>
                            <td data-label="Email" class="email-cell" title="@lead.Email">
                                @if (!string.IsNullOrEmpty(lead.Email)) { <a class="cell-link" href="mailto:@lead.Email">@lead.Email</a> } else { <text>—</text> }
                            </td>
                            <td data-label="Type / City">@(string.IsNullOrEmpty(lead.HomeType) ? (string.IsNullOrEmpty(lead.City) ? "—" : lead.City) : lead.HomeType)</td>
                            <td data-label="Source"><span class="source-tag">@lead.Source</span></td>
                            <td data-label="Message" class="msg-cell" title="@lead.Message">@(string.IsNullOrEmpty(lead.Message) ? "—" : lead.Message)</td>
                            <td data-label="Status">
                                <form method="post" asp-page-handler="UpdateStatus" class="status-form">
                                    <input type="hidden" name="id" value="@lead.Id" />
                                    <input type="hidden" name="status" value="@Model.Status" />
                                    <input type="hidden" name="q" value="@Model.Q" />
                                    <select name="newStatus" class="status-select status-@lead.Status" onchange="this.form.submit()">
                                        <option value="new" selected="@(lead.Status == "new")">New</option>
                                        <option value="contacted" selected="@(lead.Status == "contacted")">Contacted</option>
                                        <option value="closed" selected="@(lead.Status == "closed")">Closed</option>
                                    </select>
                                </form>
                            </td>
                            <td data-label="Actions" class="actions-cell">
                                <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete this consultation request? This cannot be undone.')">
                                    <input type="hidden" name="id" value="@lead.Id" />
                                    <input type="hidden" name="status" value="@Model.Status" />
                                    <input type="hidden" name="q" value="@Model.Q" />
                                    <button type="submit" class="del-btn">
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
