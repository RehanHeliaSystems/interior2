@page
@model AdminDashboard.Pages.LoginModel
@{
    ViewData["Title"] = "Log In";
    Layout = "_Layout";
}

<div class="login-screen">
    <form method="post" class="login-card">
        <a class="logo" href="@Url.Page("/Login")">
            <span class="logo-mark">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.5L12 4l9 7.5"/><path d="M5.5 10v9a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-9"/><path d="M9.5 20v-6a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v6"/></svg>
            </span>
            Dwello<span>Admin</span>
        </a>
        <p class="login-sub">Enter the admin password to view consultation requests.</p>
        <input type="password" asp-for="Password" placeholder="Password" required autofocus />
        @if (Model.InvalidPassword)
        {
            <p class="login-error">Incorrect password.</p>
        }
        <button type="submit" class="btn-login">Log In</button>
    </form>
</div>
